# Copy to .env and fill in. See DEPLOY.md.

# Prisma CLI datasource (used by `prisma db push` / `generate`).
# Local dev: a libSQL/SQLite file. Resolves relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# App-side libSQL connection. Leave BOTH empty in local dev to use the local
# file at ./prisma/dev.db. In production, point these at your Turso database:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Auth.js session secret. Generate with:  npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=""
