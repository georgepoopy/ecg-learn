// ECG Learn — data model
// SQLite via Prisma. JSON-ish fields are stored as String and parsed in app code
// for maximum SQLite portability. Waveform samples are stored as base64 of the
// raw interleaved Int16 array (faithful to the PTB-XL WFDB signal), decoded by
// the canvas renderer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// A teachable ECG type (the unit of a lesson + its question bank).
model EcgType {
  id         String   @id // slug, e.g. "afib"
  name       String // "Atrial fibrillation"
  shortName  String // "AF"
  superclass String // NORM | RHYTHM | CD | MI | STTC | HYP
  scpCodes   String // JSON array of PTB-XL SCP codes that map to this type
  summary    String // one-line teaser
  order      Int      @default(0)
  tier       String   @default("intermediate") // foundational|intermediate|advanced|expert

  lesson    Lesson?
  questions Question[]
  progress  TypeProgress[]
}

/// Structured lesson content for a type (authored originally).
model Lesson {
  id         String  @id @default(cuid())
  typeId     String  @unique
  type       EcgType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  estMinutes Int     @default(5)
  sections   String // JSON: [{ heading, body }]
  keyFacts   String // JSON: string[] (the criteria this type is identified by)
}

/// A decoded PTB-XL waveform record (12-lead, 10 s).
model Record {
  id         String @id // e.g. "ptbxl-00123"
  ecgId      Int    @unique
  fs         Int // sampling rate (Hz)
  nSamples   Int
  gain       Float // ADU per mV (from .hea)
  leads      String // JSON: string[] lead names in signal order
  signalsB64 String // base64 of Int16 interleaved samples (sample-major)
  ptbReport  String? // original clinician report string (reference only)

  questions Question[]
}

/// A question. Usually shows a real waveform, but authored items may have none.
model Question {
  id              String   @id @default(cuid())
  typeId          String
  type            EcgType  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  recordId        String? // null for authored (waveform-free) items
  record          Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  kind            String   @default("identify") // identify|which-finding|rate|axis|territory|lead|criteria
  tier            String   @default("foundational") // foundational|intermediate|advanced|expert
  stem            String
  options         String // JSON: [{ id, label }]
  correctOptionId String
  explanation     String
  difficulty      Int      @default(1) // 1..4 mirrors tier
  labels          String   @default("[]") // JSON: SCP codes present on the record
  topic           String? // niche topic slug for authored items (e.g. "brugada")
  authored        Boolean  @default(false) // true = original authored, not PTB-XL derived
  leadFocus       String? // optional lead to spotlight

  states   QuestionState[]
  attempts Attempt[]
}

/// Single local user (this is a single-user local study app).
model User {
  id        String   @id @default("local")
  createdAt DateTime @default(now())

  typeProgress   TypeProgress[]
  questionStates QuestionState[]
  attempts       Attempt[]
}

/// Per-type unlock + mastery.
model TypeProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeId       String
  type         EcgType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  unlocked     Boolean   @default(false)
  unlockedAt   DateTime?
  masteryScore Float     @default(0) // 0..1 rolling accuracy-weighted mastery
  seenCount    Int       @default(0)
  correctCount Int       @default(0)

  @@unique([userId, typeId])
}

/// Spaced-repetition state per question — FSRS card (ts-fsrs).
model QuestionState {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // FSRS card fields
  dueAt         DateTime  @default(now()) // card.due
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Float     @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  learningSteps Int       @default(0)
  state         Int       @default(0) // 0 New, 1 Learning, 2 Review, 3 Relearning
  lastReview    DateTime?
  lastGrade     Int? // last FSRS rating (1 Again .. 4 Easy)
  lastSeenAt    DateTime?

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

/// Answer log (for analytics + mastery updates).
model Attempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correct        Boolean
  chosenOptionId String
  responseMs     Int?
  createdAt      DateTime @default(now())
}
